{
  "name": "unilink-workspace",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend && node scripts/sync-frontend-dist.mjs && npm run build -w backend",
    "start": "npm run start -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "overrides": {
    "body-parser": "^1.20.9",
    "lodash": "^4.18.1",
    "path-to-regexp": "^0.1.13",
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.1",
    "ws": "^8.22.1",
    "shell-quote": "1.11.0"
  }
}
