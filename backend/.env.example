PORT=8787
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_EXPIRES_IN=30m
JWT_REMEMBER_ME_EXPIRES_IN=7d
VAULT_SECRET=replace-with-a-different-long-random-string
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.com
APP_BASE_URL=http://localhost:5173
ALLOW_OTP_FALLBACK=true
ALLOW_DEMO_GOOGLE_LOGIN=true
# Email delivery for OTP / password-reset codes. Until these are set (locally
# and on Render), the API returns a temporary on-screen code instead of mail.
# Gmail example: host smtp.gmail.com, port 587, user you@gmail.com,
# pass <16-char App Password>, from "UniLink <you@gmail.com>".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
